# Configuración de Apache para el sitio (simai.cl).
#
# Angular es una aplicación de una sola página: el servidor sólo tiene
# index.html, y las rutas (/precios, /panel, /admin) las resuelve el navegador.
# Sin las reglas de abajo, entrar directo a simai.cl/precios daría 404, porque
# Apache buscaría una carpeta "precios" que no existe.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Todo por HTTPS: la cookie de sesión va con Secure, así que sobre HTTP el
  # login no funcionaría.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Los archivos y carpetas que existen se sirven tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta va a index.html, y Angular decide qué mostrar.
  RewriteRule ^ index.html [L]
</IfModule>

# ── Caché ─────────────────────────────────────────────────────────────────
# Los .js y .css llevan un hash en el nombre: cuando cambia el contenido cambia
# el nombre, así que se pueden cachear para siempre sin quedar desactualizados.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
</IfModule>

# index.html nunca se cachea: es el que apunta a los .js con hash nuevo. Si el
# navegador lo guardara, seguiría pidiendo la versión anterior tras cada
# despliegue.
<FilesMatch "index\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</FilesMatch>

# ── Compresión ────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cabeceras de seguridad ────────────────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS: el navegador deja de hablarle a este dominio por HTTP, ni siquiera
  # para que lo redirijan. Cierra la única ventana que la redirección no puede
  # cerrar — la primera petición en claro, que alguien en la misma red puede
  # interceptar antes de que el 301 alcance a llegar.
  #
  # `includeSubDomains` alcanza también a api.simai.cl, que es la que recibe
  # los documentos. A cambio, cualquier subdominio que se cree de acá en
  # adelante tiene que servir HTTPS desde el primer día.
  #
  # Un año es el valor estándar, y el compromiso que crea es real: si el
  # certificado venciera sin renovarse, el sitio queda inaccesible hasta que se
  # arregle. No hay "continuar de todos modos" que el visitante pueda apretar.
  #
  # Sin `preload` a propósito: eso mete el dominio en una lista que los
  # navegadores traen de fábrica, y salir de ahí toma meses.
  #
  # No hace falta condicionarla a HTTPS: sobre HTTP el navegador la ignora por
  # especificación.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Impide que el sitio se cargue dentro de un iframe ajeno (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # El navegador no adivina el tipo de contenido.
  Header always set X-Content-Type-Options "nosniff"
  # No se filtra la URL completa al navegar a otros sitios.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # CSP: de dónde puede cargar cosas la página, y hacia dónde puede mandarlas.
  # Lo segundo es lo que más vale acá: aunque alguien lograra inyectar código,
  # no tiene a dónde mandarse los datos — `connect-src` y `form-action` solo
  # dejan pasar este sitio y la API.
  #
  # Directiva por directiva:
  #   default-src 'self'      lo que no se nombre abajo, solo desde este sitio
  #   script-src  'unsafe-inline'  ver la nota de abajo
  #   style-src   'unsafe-inline'  Angular inyecta los estilos de cada
  #                                componente como <style> en tiempo de
  #                                ejecución, y el build mete el CSS crítico
  #                                dentro del index.html
  #   img-src     data: blob:  iconos embebidos y vistas previas locales
  #   media-src   blob:        /enviar crea un <video> con el archivo del
  #                            usuario para leer su duración antes de subirlo
  #   connect-src la API, que vive en otro subdominio
  #   form-action a dónde puede enviarse un formulario: acá y la API, nada más
  #   frame-ancestors quién puede meternos en un iframe (clickjacking); es la
  #                   versión moderna de X-Frame-Options, que se deja por los
  #                   navegadores viejos
  #   object-src 'none'  nada de <object> ni <embed>, que no se usan
  #   base-uri 'self'    que nadie reescriba <base> y con eso redirija todas
  #                      las rutas relativas a otro servidor
  #
  # Sobre `script-src 'unsafe-inline'`: debilita la política y hoy no hay cómo
  # evitarlo. El build de Angular genera un `onload="this.media='all'"` en el
  # link del CSS, y un hash lo cubriría, pero se rompe en silencio en cada
  # actualización de Angular que cambie ese atributo — y romperse significa la
  # página sin estilos. Para sacarlo hay que desactivar `inlineCriticalCss` en
  # angular.json. Aun con esto, la política sigue impidiendo cargar scripts de
  # otros dominios, que es por donde entra un ataque de verdad.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://api.simai.cl; frame-ancestors 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://api.simai.cl"
</IfModule>
