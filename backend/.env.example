# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env al repositorio.

# --- Postgres ---
DATABASE_URL=postgresql://simai:simai@localhost:5432/simai

# --- Google OAuth ---
# Se obtienen en https://console.cloud.google.com/apis/credentials
# Tipo de credencial: "ID de cliente de OAuth 2.0" > "Aplicación web"
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# URI de redirección autorizado. Debe coincidir EXACTO con lo registrado en Google.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/retorno

# --- Microsoft Entra ID (opcional) ---
# Habilita "Continuar con Microsoft", para clientes con Microsoft 365. Si estas
# tres quedan vacías el proveedor simplemente no se ofrece: /api/auth/proveedores
# no lo lista y el front no muestra el botón.
#
# La app se registra en Portal Azure -> Microsoft Entra ID -> App registrations,
# como MULTITENANT: así entra cualquier empresa con Microsoft 365 sin que haya
# que configurar nada por cliente.
#
# El URI de redirección es EL MISMO que usa Google —hay un solo retorno para
# todos los proveedores—, y hay que registrarlo también en Entra.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/retorno

# --- Sesión ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiame-por-un-valor-aleatorio-largo

# Duración de la sesión, en horas
SESSION_HOURS=8

# En desarrollo (http://localhost) va en false. En producción SIEMPRE true.
COOKIE_SECURE=false

# --- Front ---
FRONTEND_URL=http://localhost:4200

# --- Motor de procesamiento (gateway IA) ---

# Simula el motor: no llama al gateway ni escribe en su base. Sirve para probar
# el portal completo —subir, validar, medir, cobrar, listar— sin levantar la
# arquitectura de procesamiento. Los expedientes quedan en "procesando" para
# siempre, porque nadie manda el callback.
# En cualquier entorno real va en false (o no va).
MOTOR_SIMULADO=false

# API del gateway. En local, el puerto 8000 lo usa este backend, así que el
# gateway tiene que correr en otro (o cambia el puerto de uno de los dos).
GATEWAY_URL=http://localhost:8010

# Base del motor. El portal solo escribe ahí el registro del expediente que
# N8N necesita para saber cuándo está completo.
# Obligatoria salvo con MOTOR_SIMULADO=true.
MOTOR_DATABASE_URL=postgresql://usuario:clave@servidor:5432/motor

# Empresa y canal con que el portal se identifica ante el gateway. Tienen que
# existir en su base: los crea IA-ADMIN.
GATEWAY_EMPRESA_ID=1
GATEWAY_CANAL=portal-simai

# URL pública de ESTE backend: la que N8N usa para entregar el resultado.
# En desarrollo, con N8N fuera de tu máquina, necesitas un túnel.
PUBLIC_URL=http://localhost:8000

# Secreto compartido con el flujo N8N que entrega el resultado. Ese endpoint
# no lleva cookie de sesión —lo llama un servidor, no un navegador—, así que
# este token es lo único que lo protege.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLBACK_TOKEN=cambiame-por-un-valor-aleatorio

# Correos que pueden entrar a la administración, separados por coma.
# Vacío = nadie, y la sección responde 404 a todos.
ADMIN_EMAILS=tu@correo.cl
